MLFLOW_TRACKING_URI=https://dagshub.com/Mohamed-G11/ClaimsPilot.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
# docker compose: folder holding the Ollama models pulled on the host (qwen2.5:7b),
# mounted into the ollama container. Windows default: C:/Users/<you>/.ollama/models
OLLAMA_MODELS_DIR=

# Langfuse tracing (cloud, optional: empty keys = no tracing). Project settings -> API keys.
# LANGFUSE_BASE_URL is the region URL, e.g. https://cloud.langfuse.com
# (the older name LANGFUSE_HOST is also accepted).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# NLP agent method: llm (Ollama extraction, falls back to keywords) or keywords. Default llm.
NLP_METHOD=llm
